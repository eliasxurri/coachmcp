# Copiar a backend.hcl y ajustar. backend.hcl está en .gitignore.
#
# El bucket debe existir antes del primer init y conviene crearlo con
# versionado activado: es lo que permite recuperar el estado si un apply
# lo corrompe.
#
#   aws s3api create-bucket --bucket TU-BUCKET --region sa-east-1 \
#       --create-bucket-configuration LocationConstraint=sa-east-1
#   aws s3api put-bucket-versioning --bucket TU-BUCKET \
#       --versioning-configuration Status=Enabled
#
# Después:  terraform init -backend-config=backend.hcl

bucket = "lol-pipeline-tfstate-TU-ID-DE-CUENTA"
key    = "lol-pipeline/terraform.tfstate"
region = "sa-east-1"

encrypt = true

# Bloqueo nativo en S3, sin tabla de DynamoDB. Requiere Terraform >= 1.10.
use_lockfile = true
